{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run *)",
      "Bash(node raster.js *)",
      "Bash(node compose.js *)",
      "Bash(node pipeline.js *)",
      "Bash(node server.js *)",
      "Bash(node qa.js *)",
      "Bash(node qa-html.js *)",
      "Bash(node compare.js *)",
      "Bash(node rastersysteme.js *)",
      "Bash(node -e *)",
      "Bash(git *)"
    ]
  },
  "plugins": [
    ".claude/plugins/rs"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '(.tool_input.file_path // .tool_response.filePath // .tool_input.command // \"\")' | { read -r f; echo \"$f\" | grep -q 'decks/.*\\.html' && node build-manifest.js || true; }",
            "timeout": 10,
            "statusMessage": "Updating gallery manifest..."
          }
        ]
      }
    ]
  }
}
