{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(bash *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/reject-inline-servers.sh",
            "timeout": 5,
            "statusMessage": "Checking for inline server code..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '(.tool_input.file_path // .tool_response.filePath // .tool_input.command // \"\")' | { read -r f; echo \"$f\" | grep -q 'decks/.*\\.html' && node build-manifest.js 2>/dev/null || true; }",
            "timeout": 15,
            "statusMessage": "Updating gallery manifest..."
          }
        ]
      }
    ]
  }
}
